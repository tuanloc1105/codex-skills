{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "bundle_root", "tracker_id", "worktree", "branch", "starting_head", "ending_head", "commits", "files_changed", "checks", "remaining_items", "blockers", "risks"],
  "properties": {
    "status": { "type": "string", "enum": ["implemented", "blocked", "incomplete", "failed"] },
    "bundle_root": { "type": "string" },
    "tracker_id": { "type": "string" },
    "worktree": { "type": "string" },
    "branch": { "type": "string" },
    "starting_head": { "type": "string" },
    "ending_head": { "type": "string" },
    "commits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha", "subject"],
        "properties": { "sha": { "type": "string" }, "subject": { "type": "string" } }
      }
    },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "result"],
        "properties": { "command": { "type": "string" }, "result": { "type": "string" } }
      }
    },
    "remaining_items": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } }
  }
}
