{
  "description": "Dormant Jarvis supervision guardrails activated only by explicit skill use.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/jarvis_hook.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\jarvis_hook.py\"",
            "timeout": 3,
            "additionalContextLimit": 800
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/jarvis_hook.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\jarvis_hook.py\"",
            "timeout": 3,
            "additionalContextLimit": 800
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/jarvis_hook.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\jarvis_hook.py\"",
            "timeout": 3,
            "additionalContextLimit": 800
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/jarvis_hook.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\jarvis_hook.py\"",
